# ShopVerse frontend — environment template. Copy to .env.local for local dev.

# ─── Browser-side (BUILD-TIME) ───────────────────────────────────────────────
# NEXT_PUBLIC_* are inlined into the JS bundle at `next build`. They MUST be
# passed as image build-args at release time — setting them as runtime/
# deployment env has NO effect on the already-built browser bundle. Include the
# /api global prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api          # main API client (src/lib/api.ts)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000/api      # legacy axiosInstance client
NEXT_PUBLIC_SITE_URL=http://localhost:3000             # canonical site URL (SEO / OG)
# NEXT_PUBLIC_STORE_CURRENCY=USD
# NEXT_PUBLIC_STORE_LOCALE=en-US

# ─── Server-side (RUNTIME) ───────────────────────────────────────────────────
# Read by the Next server process at runtime: NextAuth authorize, SSR, SEO,
# entitlements. In split-host / containerized deploys the SERVER reaches the
# backend at a DIFFERENT hostname than the browser, so set this to the internal
# service URL (e.g. http://backend:3001/api in compose,
# http://shopverse-backend/api in k8s). Falls back to NEXT_PUBLIC_API_URL when
# unset (fine for single-origin deploys). Must include the /api prefix.
# See src/lib/server-api.ts.
BACKEND_INTERNAL_URL=http://localhost:4000/api
# Cap the login request to the backend (ms). Default 5000. See lib/auth-credentials.ts.
# AUTH_HTTP_TIMEOUT_MS=5000

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-32-chars-minimum

# ─── Analytics (optional) ────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
