// ─── Distributed Cron Lock ───────────────────────────────────────────────────
// FINAL §9.4 M-005: prevents duplicate cron execution across multi-instance deployments.
// A job first INSERTs a row keyed by job name with an expiry. Unique-constraint violation
// means another instance holds the lock.
model CronLock {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  holder     String   // instance id / hostname that owns the lock
  acquiredAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

// ─── Invoice (D-04, §22.1) ────────────────────────────────────────────────────
// I-13: invoice sequence number is continuous per financial year (no gaps).
// Generated when order transitions to CONFIRMED. One invoice per order.

model Invoice {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique
  order          Order    @relation(fields: [orderId], references: [id])
  invoiceNumber  String   @unique       // e.g. "INV/2026-27/000001"
  financialYear  String                 // e.g. "2026-27" (Apr→Mar India FY)
  sequence       Int                   // monotonic within financialYear, 1-based
  subtotal       Float
  discountAmount Float    @default(0)
  shippingFee    Float    @default(0)
  taxAmount      Float    @default(0)
  total          Float
  issuedAt       DateTime @default(now())

  @@unique([financialYear, sequence])
  @@index([financialYear])
  @@index([issuedAt])
}

// ─── Maker-Checker (ADM-RBAC, §16.2) ─────────────────────────────────────────
// High-value refunds (> ₹5000) require a FINANCE-role approver to approve
// before the actual refund is executed. CS_AGENT creates the request; FINANCE approves.

model RefundApproval {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id])
  amount        Float
  reason        String
  requestedBy   Int                               // userId of CS_AGENT requestor
  requestedAt   DateTime @default(now())
  approvedBy    Int?                              // userId of FINANCE approver
  approvedAt    DateTime?
  rejectedBy    Int?
  rejectedAt    DateTime?
  rejectedReason String?
  status        RefundApprovalStatus @default(PENDING)
  refundRequest RefundRequest?       @relation(fields: [refundRequestId], references: [id])
  refundRequestId Int?               @unique       // set after approval triggers refund

  @@index([orderId])
  @@index([status])
}

enum RefundApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED   // refund was triggered after approval
}

// Monotonic per-year counter. Locked with SELECT ... FOR UPDATE for atomicity.
model InvoiceSequence {
  id            Int    @id @default(autoincrement())
  financialYear String @unique          // "2026-27"
  lastSequence  Int    @default(0)      // incremented atomically; next invoice = lastSequence + 1
}

// --- Security Monitoring (H2-10) ---

model SecurityAlert {
  id          Int       @id @default(autoincrement())
  type        String
  severity    String    @default("MEDIUM")
  metadata    Json
  resolvedAt  DateTime?
  resolvedBy  Int?
  createdAt   DateTime  @default(now())

  @@index([type, createdAt])
  @@index([resolvedAt])
}

// ─── F1-04: Recently Viewed (server-persisted) ────────────────────────────────
model RecentlyViewed {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, viewedAt(sort: Desc)])
}

// ─── F2-06: In-app Notification Center — moved to prisma/schema/notifications.prisma in W4.T13

// ─── F2-11: Trending / Popular Searches ──────────────────────────────────────
model SearchLog {
  id          Int      @id @default(autoincrement())
  query       String
  userId      Int?
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([query, createdAt])
  @@index([createdAt])
}

// ─── F2-12: Exchange Flow ─────────────────────────────────────────────────────
model ExchangeRequest {
  id                 Int            @id @default(autoincrement())
  orderId            Int
  order              Order          @relation(fields: [orderId], references: [id])
  orderItemId        Int
  orderItem          OrderItem      @relation(fields: [orderItemId], references: [id])
  requestedVariantId Int
  requestedVariant   Variant        @relation("ExchangeTargetVariant", fields: [requestedVariantId], references: [id])
  reason             String
  status             ExchangeStatus @default(PENDING)
  adminNote          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
}

enum ExchangeStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
  COMPLETED
}

// ─── F2-13: Delivery Feedback / Rating ───────────────────────────────────────
model DeliveryRating {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
}

// ─── F2-14: Customer Q&A ──────────────────────────────────────────────────────
model ProductQuestion {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  question    String
  answer      String?
  answeredBy  Int?
  answeredAt  DateTime?
  isApproved  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([productId, isApproved])
}

