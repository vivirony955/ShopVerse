generator client {
  provider        = "prisma-client-js"
  // Path is relative to this schema FILE — now `prisma/schema/main.prisma`
  // — so two `../` to reach the repo root, then into backend's node_modules.
  output          = "../../backend/node_modules/.prisma/client"
  // W1.T7 — `prismaSchemaFolder` lets the schema span multiple .prisma
  // files under prisma/schema/. Kernel models live in main.prisma;
  // first-party plugin schemas (W2+) ship as sibling files in the same
  // folder and Prisma concatenates them at parse time.
  previewFeatures = ["prismaSchemaFolder"]
  // A2 observability: Prisma 6+ emits OTel spans automatically when
  // @prisma/instrumentation is registered (no preview flag required).
  // Safe when SDK is absent (test env) — Prisma emits no spans without
  // a registered tracer provider.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN        // legacy super-admin (keeps backward compat)
  CS_AGENT     // view orders; initiate refund ≤ ₹5000
  OPS          // update shipment status, manage inventory, pack orders
  FINANCE      // approve high-value refunds (> ₹5000), view ledger
  MERCH        // manage products, pricing, promotions, flash sales
  SUPER_ADMIN  // all access + user impersonation
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  // FINAL §9.4 R-004: intermediate state entered when a destructive refund is in-flight
  // with the payment gateway. Transitions to CANCELLED / REFUNDED on webhook ack, or back
  // to CONFIRMED/PROCESSING if the gateway call fails. Prevents double-refund on retry.
  CANCELLING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  STRIPE
  COD
}

enum DiscountType {
  PERCENTAGE
  FIXED
  CASHBACK
}

enum FlashSaleStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  REFUNDED
}

// ─── Users & Addresses ────────────────────────────────────────────────────────

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  password            String
  firstName           String?
  lastName            String?
  phone               String?
  role                Role                 @default(USER)
  loyaltyPoints       Int                  @default(0)
  referralCode        String?              @unique
  referredById        Int?
  referredBy          User?                @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]               @relation("Referrals")
  addresses           Address[]
  cart                Cart?
  wishlists           Wishlist[]
  orders              Order[]
  reviews             Review[]
  loyaltyTransactions LoyaltyTransaction[]
  referrerCredits     ReferralCredit[]     @relation("ReferrerCredits")
  refereeCredit       ReferralCredit?      @relation("RefereeCredit")
  abandonedCarts      AbandonedCart[]
  wallet              Wallet?
  riskScore           UserRiskScore?
  preOrders           PreOrder[]
  savedForLater       SavedForLater[]
  supportTickets      SupportTicket[]
  affiliateAccount    AffiliateAccount?
  cookieConsents      CookieConsent[]
  adminAuditLogs      AdminAuditLog[]
  refundRequests      RefundRequest[]
  couponUsages        CouponUsage[]
  reviewVotes         ReviewVote[]
  recentlyViewed      RecentlyViewed[]
  notifications       Notification[]
  productQuestions    ProductQuestion[]
  priceAlerts         PriceAlert[]
  blogPosts           BlogPost[]
  // V-10: incremented on password change to invalidate all active refresh tokens
  tokenVersion        Int                  @default(0)
  // H2-01: account lockout after repeated failed logins
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Address {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  slug     String     @unique
  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  // FINAL §9.4 C-006: category-specific return window (days). NULL → use global default.
  // e.g. electronics 7d, apparel 30d, innerwear 0 (non-returnable).
  returnWindowDays Int? @default(7)
  sizeCharts       SizeChart[]
  volumeDiscounts  VolumeDiscount[]
}

// F1-06: Category-level size charts (e.g., "Men's Tops", "Women's Footwear")
model SizeChart {
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String   // e.g., "Men's T-Shirts & Shirts"
  unit       String   @default("cm") // cm, inches
  data       Json     // [{ size: "S", chest: 92, waist: 76, length: 68 }, ...]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  products Product[]
}

model Product {
  id              Int                @id @default(autoincrement())
  name            String
  slug            String             @unique
  description     String
  brandId         Int
  brand           Brand              @relation(fields: [brandId], references: [id])
  categoryId      Int
  category        Category           @relation(fields: [categoryId], references: [id])
  basePrice       Float
  discountPct     Float              @default(0)
  images          String[]
  tags            String[]
  variants        Variant[]
  reviews         Review[]
  wishlists       Wishlist[]
  faqs            ProductFaq[]
  flashSaleItems  FlashSaleProduct[]
  isActive        Boolean            @default(true)
  // B-14 PERF: write-through rating cache. Avoids N+1 review aggregation on PLP/PDP.
  // Maintained by reviews.service.ts on create/update/delete (I-new: cache == ∑Review).
  avgRating       Float              @default(0)
  reviewCount     Int                @default(0)
  // F1-07: structured specs (material, weight, dimensions, care instructions, etc.)
  specifications  Json?
  // F1-10: product demo/unboxing/review videos
  videos          String[]           @default([])
  recentlyViewed  RecentlyViewed[]
  productQuestions ProductQuestion[]
  priceAlerts     PriceAlert[]
  priceHistory    PriceHistory[]
  volumeDiscounts VolumeDiscount[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, createdAt])
  @@index([discountPct])
}

model Variant {
  id         Int         @id @default(autoincrement())
  productId  Int
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  color      String
  // FINAL §7.1 / §9.4 R-001: `stock` = physically on-hand units (authoritative for MVP,
  // denormalized from WarehouseInventory sum once multi-warehouse is live).
  // `reservedStock` = units promised to live orders not yet shipped. Sellable = stock − reservedStock.
  // DB CHECK enforces stock ≥ 0, reservedStock ≥ 0, reservedStock ≤ stock (see migration).
  stock         Int         @default(0)
  reservedStock Int         @default(0)
  soldCount  Int         @default(0)
  backorderAllowed Boolean @default(false)
  // FINAL §4.1 item caps
  minOrderQty  Int         @default(1)
  maxOrderQty  Int         @default(10)
  sku               String               @unique
  cartItems         CartItem[]
  orderItems        OrderItem[]
  warehouseInventory WarehouseInventory[]
  shipmentItems     ShipmentItem[]
  cartReservationItems CartReservationItem[]
  preOrders         PreOrder[]
  savedForLater     SavedForLater[]
  stockNotifications  StockNotification[]
  exchangeRequests    ExchangeRequest[]   @relation("ExchangeTargetVariant")

  @@index([productId])
  @@index([stock])
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id           Int               @id @default(autoincrement())
  userId       Int               @unique
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]
  reservations CartReservation[]
  updatedAt    DateTime          @updatedAt
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([cartId, variantId])
}

// ─── Wishlist ─────────────────────────────────────────────────────────────────

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id                  Int             @id @default(autoincrement())
  userId              Int?
  user                User?           @relation(fields: [userId], references: [id])
  items               OrderItem[]
  trackingEvents      TrackingEvent[]
  returnRequest       ReturnRequest?
  addressSnapshot     Json
  guestEmail          String?
  subtotal            Float
  discountAmount      Float           @default(0)
  shippingFee         Float           @default(0)   // flat shipping charge applied at checkout
  taxAmount           Float           @default(0)   // GST/IGST on (subtotal - discount)
  loyaltyPointsUsed   Int             @default(0)
  loyaltyPointsEarned Int             @default(0)
  // F1-15: split payment — wallet portion used to partially pay this order
  walletAmountUsed    Float           @default(0)
  total               Float
  couponCode          String?
  status              OrderStatus     @default(PENDING)
  paymentMethod       PaymentMethod   @default(STRIPE)
  paymentId           String?
  paymentStatus       PaymentStatus   @default(UNPAID)
  shipments           Shipment[]
  giftOption          GiftOption?
  reconciliation      PaymentReconciliation?
  refundRequests      RefundRequest[]
  refundApprovals     RefundApproval[]
  invoice             Invoice?
  attributions        CampaignAttribution[]
  exchangeRequests    ExchangeRequest[]
  deliveryRating      DeliveryRating?
  parentOrderId       Int?            // set on split sub-orders; references the original order
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([parentOrderId])
}

model OrderItem {
  id             Int           @id @default(autoincrement())
  orderId        Int
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      Int
  variant        Variant       @relation(fields: [variantId], references: [id])
  quantity       Int
  price          Float
  // Partial-cancellation marker (FINAL §9.4 C-004). NULL = active line, non-NULL = cancelled.
  cancelledAt    DateTime?
  // Per-item refund marker (FINAL §9.4 R-008 / M-006). Used to derive the
  // aggregate Order.paymentStatus (REFUNDED when all items refunded, PARTIALLY_REFUNDED otherwise).
  refundedAt     DateTime?
  refundReason   RefundReason?
  returnItems    ReturnItem[]
  refundRequests   RefundRequest[]
  exchangeRequests ExchangeRequest[]

  @@index([orderId])
  // B-13 PERF: covers partial-cancellation scan (WHERE orderId=? AND cancelledAt IS NULL)
  @@index([orderId, cancelledAt])
}

// FINAL §9.4 M-006: controlled refund-reason taxonomy for analytics + ops routing.
enum RefundReason {
  CUSTOMER_CHANGED_MIND
  DAMAGED_ON_ARRIVAL
  WRONG_ITEM_SHIPPED
  NOT_AS_DESCRIBED
  DELIVERY_FAILED
  QUALITY_ISSUE
  SIZE_FIT_ISSUE
  DUPLICATE_ORDER
  ADMIN_ADJUSTMENT
  OTHER
}

model TrackingEvent {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model ReturnRequest {
  id            Int          @id @default(autoincrement())
  orderId       Int          @unique
  order         Order        @relation(fields: [orderId], references: [id])
  reason        String
  items         ReturnItem[]
  // Assigned by ops after triage (FINAL §9.4 R-006). NULL at customer-request time.
  returnAddress String?
  status        ReturnStatus @default(REQUESTED)
  adminNote     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model ReturnItem {
  id              Int           @id @default(autoincrement())
  returnRequestId Int
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     Int
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id                 Int          @id @default(autoincrement())
  userId             Int
  user               User         @relation(fields: [userId], references: [id])
  productId          Int
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating             Int
  title              String?
  body               String?
  isVerifiedPurchase Boolean      @default(false)
  // F1-09: helpfulness voting
  helpfulCount       Int          @default(0)
  votes              ReviewVote[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([userId, productId])
}

// F1-09: one vote per user per review (thumbs up/down)
model ReviewVote {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  isHelpful Boolean  // true = helpful, false = not helpful
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
}

// ─── Coupons ──────────────────────────────────────────────────────────────────

model Coupon {
  id             Int           @id @default(autoincrement())
  code           String        @unique
  discountType   DiscountType
  discountValue  Float
  minOrderAmount Float         @default(0)
  maxUses        Int?
  maxUsesPerUser  Int?          // T-C02: optional per-user cap (null = unlimited per user)
  firstOrderOnly  Boolean       @default(false) // if true, coupon only valid when user has no prior DELIVERED orders
  usedCount       Int           @default(0)
  expiresAt       DateTime?
  isActive        Boolean       @default(true)
  usages         CouponUsage[]
}

// T-C02: tracks per-user coupon usage — enforces maxUsesPerUser and prevents reuse abuse
model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime @default(now())

  @@unique([couponId, userId]) // one record per user per coupon; increment usedCount there
  @@index([userId])
}

// ─── Product FAQs ─────────────────────────────────────────────────────────────

model ProductFaq {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Delivery / Pincode ───────────────────────────────────────────────────────

model PincodeServiceability {
  id            Int     @id @default(autoincrement())
  pincode       String  @unique
  isServiceable Boolean @default(true)
  estimateDays  Int     @default(5)
  courier       String?
}

// ─── Flash Sales ─────────────────────────────────────────────────────────────

model FlashSale {
  id          Int                @id @default(autoincrement())
  title       String
  slug        String             @unique
  discountPct Float
  startsAt    DateTime
  endsAt      DateTime
  status      FlashSaleStatus    @default(SCHEDULED)
  products    FlashSaleProduct[]
  createdAt   DateTime           @default(now())
}

model FlashSaleProduct {
  id              Int       @id @default(autoincrement())
  flashSaleId     Int
  flashSale       FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product   @relation(fields: [productId], references: [id])
  perUserMaxQty   Int       @default(0)   // 0 = unlimited; >0 enforced per user per flash sale

  @@unique([flashSaleId, productId])
}

// ─── Loyalty Points ───────────────────────────────────────────────────────────

model LoyaltyTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  orderId   Int?
  points    Int
  type      String   // EARN | REDEEM | REFERRAL_BONUS | MANUAL
  note      String?
  // Deterministic idempotency key (FINAL §9.4 C-007). e.g. "earn:order:<id>", "redeem:order:<id>"
  reference String?  @unique
  createdAt DateTime @default(now())

  @@index([userId, type])
}

// ─── Abandoned Cart ───────────────────────────────────────────────────────────

model AbandonedCart {
  id             Int       @id @default(autoincrement())
  userId         Int?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestEmail     String?
  cartSnapshot   Json
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─── Referral Credits ─────────────────────────────────────────────────────────

model ReferralCredit {
  id           Int      @id @default(autoincrement())
  referrerId   Int
  referrer     User     @relation("ReferrerCredits", fields: [referrerId], references: [id])
  newUserId    Int      @unique
  newUser      User     @relation("RefereeCredit", fields: [newUserId], references: [id])
  creditAmount Int
  appliedAt    DateTime @default(now())
}

// ─── Warehouse & Fulfillment ──────────────────────────────────────────────────

model Warehouse {
  id          Int                  @id @default(autoincrement())
  name        String
  code        String               @unique
  city        String
  state       String
  pincode     String
  lat         Float?
  lng         Float?
  isActive    Boolean              @default(true)
  inventory   WarehouseInventory[]
  shipments   Shipment[]
  cartReservationItems CartReservationItem[]
  createdAt   DateTime             @default(now())
}

model WarehouseInventory {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  variantId   Int
  variant     Variant   @relation(fields: [variantId], references: [id])
  stock       Int       @default(0)
  reserved    Int       @default(0)

  @@unique([warehouseId, variantId])
  @@index([variantId])
}

model Shipment {
  id            Int          @id @default(autoincrement())
  orderId       Int
  order         Order        @relation(fields: [orderId], references: [id])
  warehouseId   Int
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])
  items         ShipmentItem[]
  trackingCode  String?
  carrier       String?
  status        ShipmentStatus @default(PENDING)
  expectedAt    DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model ShipmentItem {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  variantId  Int
  variant    Variant  @relation(fields: [variantId], references: [id])
  quantity   Int
}

// ─── Cart Reservation ─────────────────────────────────────────────────────────

// FINAL §4.2 — parent/child. Parent = one row per checkout attempt,
// child = one row per reserved line. placeOrder() requires a valid reservationId.
enum CartReservationStatus {
  ACTIVE
  EXPIRED
  CONSUMED
}

model CartReservation {
  id        Int                   @id @default(autoincrement())
  cartId    Int
  cart      Cart                  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId    Int
  status    CartReservationStatus @default(ACTIVE)
  expiresAt DateTime
  isFlash   Boolean               @default(false)
  items     CartReservationItem[]
  createdAt DateTime              @default(now())

  @@index([userId, status, expiresAt])
  @@index([expiresAt])
}

model CartReservationItem {
  id            Int             @id @default(autoincrement())
  reservationId Int
  reservation   CartReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  variantId     Int
  variant       Variant         @relation(fields: [variantId], references: [id])
  warehouseId   Int
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])
  quantity      Int
  lockedPrice   Float
  lockedMrp     Float

  @@unique([reservationId, variantId])
  @@index([variantId])
}

// ─── Notify-when-back-in-stock (FINAL §3.2) ───────────────────────────────────

model StockNotification {
  id          Int       @id @default(autoincrement())
  variantId   Int
  variant     Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  email       String
  phone       String?
  createdAt   DateTime  @default(now())
  notifiedAt  DateTime?

  @@index([notifiedAt])
}

// ─── Refund requests (FINAL §9.3, I-11) ───────────────────────────────────────

enum RefundRequestStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

enum RefundDestination {
  ORIGINAL_PAYMENT
  WALLET
}

model RefundRequest {
  id             Int                  @id @default(autoincrement())
  orderId        Int
  order          Order                @relation(fields: [orderId], references: [id])
  orderItemId    Int?
  orderItem      OrderItem?           @relation(fields: [orderItemId], references: [id])
  amount         Float
  reason         String?
  status         RefundRequestStatus  @default(PENDING)
  destination    RefundDestination    @default(ORIGINAL_PAYMENT)
  gatewayRef     String?
  reference      String               @unique
  requestedById  Int?
  requestedBy    User?                @relation(fields: [requestedById], references: [id])
  processedAt    DateTime?
  failureReason  String?
  // W5 PERF: retry counter for gateway failures. Cron bumps this on each retry attempt;
  // after MAX_REFUND_RETRIES (5), row is marked FAILED permanently + alert logged.
  retryCount     Int                  @default(0)
  lastRetryAt    DateTime?
  walletTxns      WalletTransaction[]
  refundApproval  RefundApproval?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([orderId])
  @@index([status])
  // B-13 PERF: covers order-scoped refund lookups filtered by status
  @@index([orderId, status])
  // W5 PERF: covers refund retry cron scan
  @@index([status, updatedAt])
}

// ─── Pre-orders & Backorders ──────────────────────────────────────────────────

model PreOrder {
  id               Int           @id @default(autoincrement())
  userId           Int
  user             User          @relation(fields: [userId], references: [id])
  variantId        Int
  variant          Variant       @relation(fields: [variantId], references: [id])
  quantity         Int
  priceAtPreorder  Float
  expectedDate     DateTime?
  status           PreOrderStatus @default(PENDING)
  convertedOrderId Int?
  createdAt        DateTime      @default(now())

  @@index([variantId, status])
}

// ─── Wallet & Financial Ledger ────────────────────────────────────────────────

model Wallet {
  id           Int               @id @default(autoincrement())
  userId       Int               @unique
  user         User              @relation(fields: [userId], references: [id])
  balance      Float             @default(0)
  transactions WalletTransaction[]
  updatedAt    DateTime          @updatedAt
}

model WalletTransaction {
  id          Int                   @id @default(autoincrement())
  walletId    Int
  wallet      Wallet                @relation(fields: [walletId], references: [id])
  amount      Float
  type        WalletTxType
  // FINAL §9.4 C-003/R-003: NOT NULL + composite unique to guarantee at-most-once.
  // Callers should pass a deterministic key (e.g. "refund:order:42"); the service
  // auto-generates a UUID key when the caller has nothing to de-dupe on.
  reference   String
  description String?
  balanceAfter Float
  refundRequestId Int?
  refundRequest  RefundRequest? @relation(fields: [refundRequestId], references: [id])
  createdAt   DateTime              @default(now())

  @@unique([walletId, reference, type])
  @@index([walletId, createdAt])
  @@index([refundRequestId])
}

model LedgerEntry {
  id          Int         @id @default(autoincrement())
  type        LedgerType
  debitAmount Float       @default(0)
  creditAmount Float      @default(0)
  reference   String      // orderId, refundId, walletTxId
  description String?
  createdAt   DateTime    @default(now())

  @@index([reference])
  @@index([createdAt])
}

model PaymentReconciliation {
  id              Int               @id @default(autoincrement())
  gatewayRef      String            @unique
  orderId         Int?              @unique
  order           Order?            @relation(fields: [orderId], references: [id])
  gatewayAmount   Float
  internalAmount  Float?
  status          ReconcileStatus   @default(PENDING)
  discrepancy     Float?
  resolvedAt      DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
}

// ─── Fraud & Returns Abuse ────────────────────────────────────────────────────

model UserRiskScore {
