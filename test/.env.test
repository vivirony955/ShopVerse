# Integration test environment overrides.
# Copy this file to set up your test database.
# TEST_DATABASE_URL takes precedence over DATABASE_URL from backend/.env
#
# Example (separate test database — recommended):
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/shopverse_test
#
# If TEST_DATABASE_URL is not set, the tests will use DATABASE_URL from backend/.env
# WARNING: Using the same DB as development will wipe your dev data!

# Uncomment and fill in to use a dedicated test database:
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/shopverse_test

JWT_SECRET=test-jwt-secret-do-not-use-in-production
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
