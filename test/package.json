{
  "name": "shopverse-integration-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack integration tests for ShopVerse: backend HTTP, database, and frontend API client",
  "scripts": {
    "test": "jest --config jest.config.ts --runInBand --forceExit",
    "test:watch": "jest --config jest.config.ts --runInBand --watch",
    "test:cov": "jest --config jest.config.ts --runInBand --forceExit --coverage",
    "test:auth": "jest --config jest.config.ts --runInBand --forceExit --testPathPattern=auth",
    "test:users": "jest --config jest.config.ts --runInBand --forceExit --testPathPattern=users",
    "test:products": "jest --config jest.config.ts --runInBand --forceExit --testPathPattern=products",
    "test:cart": "jest --config jest.config.ts --runInBand --forceExit --testPathPattern=cart",
    "test:orders": "jest --config jest.config.ts --runInBand --forceExit --testPathPattern=orders"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.6.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^11.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
