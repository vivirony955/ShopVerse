{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    // Required so ts-jest emits the `__importDefault` helper for CJS modules
    // without a real default export (supertest in particular). Without this,
    // `import request from 'supertest'` compiles fine but throws at runtime
    // because `supertest_1.default` is undefined.
    "esModuleInterop": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "paths": {
      "@users/*": ["src/users/*"]
    }
  }
}
