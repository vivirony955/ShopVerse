# ── ShopVerse Backend Environment ──────────────────────────
# Generated by Ansible — do not edit manually on the server.
# Re-run deploy.sh to update.

# Database
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_ip }}:5432/{{ db_name }}

# Auth
JWT_SECRET={{ jwt_secret }}

# Stripe
STRIPE_SECRET_KEY={{ stripe_secret_key }}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret }}

# CORS  (comma-separated origins)
CORS_ORIGIN={{ cors_origins }}

# Server
PORT={{ backend_port }}
NODE_ENV=production

# Admin seed (used by npm run seed)
SEED_ADMIN_EMAIL={{ seed_admin_email }}
SEED_ADMIN_PASSWORD={{ seed_admin_password }}
