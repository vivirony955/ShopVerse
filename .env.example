# ShopVerse — environment template
# Copy to .env (at project root AND prisma/.env) and fill in real values.

# ─── Database ────────────────────────────────────────────────────────────────
# B-05 PERF: connection_limit=30 tunes Prisma's pool to match pg max_connections
# (default is num_cpus * 2 + 1 which under-utilises the DB under load).
# Raise cautiously if pg's max_connections allows it.
DATABASE_URL="postgresql://user:password@localhost:5432/shopverse?connection_limit=30"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="15m"

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@shopverse.local"

# ─── Redis (Wave 4+) ─────────────────────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT="3001"
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ─── Observability (A2) — all off by default ─────────────────────────────────
# All three observability layers are opt-in. Leave any/all unset to disable.

# OpenAPI / Swagger UI (production only — dev is always open)
# Set both SWAGGER_USER and SWAGGER_PASS to enable /api/docs in production.
# Leaving either unset → /api/docs returns 404 in production (default behaviour).
# SWAGGER_USER=""
# SWAGGER_PASS=""

# Sentry — error tracking only (we use OTel for tracing, see below).
# Leave SENTRY_DSN unset to disable. PII scrubbing is built in.
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"        # defaults to NODE_ENV
# SENTRY_RELEASE=""                      # set by CI to git SHA on main

# OpenTelemetry — distributed tracing. Set OTLP endpoint to enable.
# Local dev: `docker run -d -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one`
# then OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318" and visit
# http://localhost:16686 to see traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=""         # e.g. http://localhost:4318
# OTEL_SERVICE_NAME="shopverse-backend"
# OTEL_TRACES_SAMPLER_ARG="0.1"          # 10% head sampling; errors always sampled
# OTEL_LOG_LEVEL=""                      # set to "debug" to debug OTel itself

# Prometheus /metrics endpoint — BasicAuth in production.
# Format: "user:pass". Unset in production → /api/metrics returns 503 (fail closed).
# METRICS_BASIC_AUTH=""
