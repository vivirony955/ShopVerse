# ShopVerse — environment template
# Copy to .env (at project root AND prisma/.env) and fill in real values.

# ─── Database ────────────────────────────────────────────────────────────────
# B-05 PERF: connection_limit=30 tunes Prisma's pool to match pg max_connections
# (default is num_cpus * 2 + 1 which under-utilises the DB under load).
# Raise cautiously if pg's max_connections allows it.
DATABASE_URL="postgresql://user:password@localhost:5432/shopverse?connection_limit=30"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="15m"

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@shopverse.local"

# ─── Redis (Wave 4+) ─────────────────────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT="3001"
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
